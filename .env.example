# ============================================================
# ARCHIVO DE CONFIGURACIÓN - NEWSLETTER MENSUAL AUTOMATIZADO
# ============================================================
#
# INSTRUCCIONES:
# 1. Copia este archivo a .env:
#    cp .env.example .env
#
# 2. Reemplaza los valores de ejemplo con tus credenciales reales
#
# 3. NUNCA subas el archivo .env a Git (está en .gitignore)
#
# ============================================================

# ------------------------------------------------------------
# PINECONE - Base de Datos Vectorial
# ------------------------------------------------------------
# Obtén tus credenciales en: https://app.pinecone.io/
PINECONE_API_KEY=your-pinecone-api-key-here
PINECONE_ENVIRONMENT=us-east-1-aws
# Opciones de environment: us-east-1-aws, us-west-2-aws, eu-west-1-aws, etc.

# ------------------------------------------------------------
# ANTHROPIC CLAUDE - Generación de Contenido
# ------------------------------------------------------------
# Obtén tu API key en: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ------------------------------------------------------------
# OPENAI - Embeddings (Opcional si usas otro proveedor)
# ------------------------------------------------------------
# Obtén tu API key en: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ------------------------------------------------------------
# GOOGLE GEMINI - Generación de Imágenes
# ------------------------------------------------------------
# Opción 1: API Key (obtener en https://makersuite.google.com/app/apikey)
GEMINI_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Opción 2: OAuth2 (configurar directamente en n8n)
# No requiere variable aquí si usas OAuth2

# ------------------------------------------------------------
# MYSQL - Base de Datos de Suscriptores
# ------------------------------------------------------------
MYSQL_HOST=mysql.dreamhost.com
MYSQL_PORT=3306
MYSQL_DATABASE=newsletter_db
MYSQL_USER=db_user
MYSQL_PASSWORD=secure_password_here

# ------------------------------------------------------------
# GOOGLE SHEETS - Logging (Service Account)
# ------------------------------------------------------------
# Ruta al archivo JSON de service account
# Descarga desde: Google Cloud Console > IAM > Service Accounts
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json

# ID del spreadsheet de logs (obtener de la URL)
# https://docs.google.com/spreadsheets/d/SPREADSHEET_ID/edit
GOOGLE_SHEETS_SPREADSHEET_ID=1abcdefghijklmnopqrstuvwxyz1234567890

# ------------------------------------------------------------
# GMAIL - Envío de Emails (OAuth2)
# ------------------------------------------------------------
# Gmail usa OAuth2, que se configura directamente en n8n
# No requiere variables aquí

# ------------------------------------------------------------
# CONFIGURACIÓN DEL WORKFLOW (Opcional)
# ------------------------------------------------------------
# Número de suscriptores por lote
BATCH_SIZE=100

# Top K artículos de Pinecone
PINECONE_TOP_K=50

# Idioma principal del newsletter
PRIMARY_LANGUAGE=en

# Idioma secundario (para snippet)
SECONDARY_LANGUAGE=es

# Mes a procesar (por defecto: mes anterior)
# Formato: YYYY-MM (dejar vacío para usar mes anterior automáticamente)
MONTH_TO_PROCESS=

# ------------------------------------------------------------
# ALTERNATIVAS DE EMBEDDINGS (Descomentar si usas)
# ------------------------------------------------------------

# VOYAGE AI
# VOYAGE_API_KEY=pa-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# COHERE
# COHERE_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# HUGGING FACE
# HUGGINGFACE_API_KEY=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ------------------------------------------------------------
# DEBUGGING Y DESARROLLO
# ------------------------------------------------------------
# Modo de desarrollo (true/false)
DEV_MODE=false

# Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Email de prueba (para enviar preview antes del envío masivo)
TEST_EMAIL=your-email@example.com

# ============================================================
# NOTAS DE SEGURIDAD
# ============================================================
#
# 1. NUNCA compartas este archivo .env
# 2. Usa contraseñas fuertes (mínimo 16 caracteres)
# 3. Rota tus API keys periódicamente (cada 3-6 meses)
# 4. Para producción, considera usar:
#    - AWS Secrets Manager
#    - Google Secret Manager
#    - HashiCorp Vault
# 5. Habilita 2FA en todas las cuentas
# 6. Revisa los logs de acceso a APIs mensualmente
#
# ============================================================

msgid "Suscríbete a nuestro boletín"
msgstr "Subscribe to our newsletter"

msgid "Nombre"
msgstr "Name"

msgid "Correo electrónico"
msgstr "Email address"

msgid "Suscribirse"
msgstr "Subscribe"

msgid "¡Gracias por suscribirte!"
msgstr "Thank you for subscribing!"

msgid "Hubo un error. Por favor, intenta de nuevo."
msgstr "An error occurred. Please try again."

msgid "Este correo ya está suscrito."
msgstr "This email is already subscribed."

msgid "Sesión inválida. Por favor, recarga la página."
msgstr "Invalid session. Please reload the page."

msgid "Por favor, completa todos los campos."
msgstr "Please complete all fields."

msgid "Por favor, ingresa un correo electrónico válido."
msgstr "Please enter a valid email address."

msgid "Este correo ya está suscrito. Si deseas, puedes darte de baja del newsletter."
msgstr "This email is already subscribed. If you wish, you can unsubscribe from the newsletter."

msgid "Por favor, proporciona un correo electrónico válido."
msgstr "Please provide a valid email address."

msgid "Te has dado de baja exitosamente. Ya no recibirás el newsletter mensual. ¡Esperamos verte de nuevo pronto!"
msgstr "You have successfully unsubscribed. You will no longer receive the monthly newsletter. We hope to see you again soon!"

msgid "Hubo un error al procesar tu baja. Por favor, intenta de nuevo."
msgstr "There was an error processing your unsubscription. Please try again."

msgid "Ya estás suscrito con este correo electrónico."
msgstr "You are already subscribed with this email address."

msgid "Si te das de baja, dejarás de recibir el newsletter mensual y te eliminaremos de nuestra lista de suscriptores."
msgstr "If you unsubscribe, you will stop receiving the monthly newsletter and we will remove you from our subscriber list."

msgid "¿Por qué deseas darte de baja? (opcional)"
msgstr "Why do you want to unsubscribe? (optional)"

msgid "Por ejemplo: Recibo demasiados correos, ya no me interesa el contenido, etc."
msgstr "For example: I receive too many emails, I'm no longer interested in the content, etc."

msgid "Darme de Baja del Newsletter"
msgstr "Unsubscribe from Newsletter"

msgid "Cancelar"
msgstr "Cancel"

msgid "Lista de Suscriptores"
msgstr "Subscribers List"

msgid "Ver Suscriptores"
msgstr "View Subscribers"

msgid "Permisos insuficientes"
msgstr "Insufficient permissions"

msgid "Error al obtener suscriptores"
msgstr "Error fetching subscribers"

msgid "Email y estado son requeridos"
msgstr "Email and status are required"

msgid "Email es requerido"
msgstr "Email is required"

msgid "Cargando..."
msgstr "Loading..."

msgid "Error al cargar suscriptores"
msgstr "Error loading subscribers"

msgid "Error de conexión"
msgstr "Connection error"

msgid "No hay suscriptores"
msgstr "No subscribers"

msgid "Activo"
msgstr "Active"

msgid "Inactivo"
msgstr "Inactive"

msgid "Desuscrito"
msgstr "Unsubscribed"

msgid "Rebotado"
msgstr "Bounced"

msgid "Cambiar Estado"
msgstr "Change Status"

msgid "Desuscribir"
msgstr "Unsubscribe"

msgid "Estado actualizado correctamente"
msgstr "Status updated successfully"

msgid "Error"
msgstr "Error"

msgid "¿Por qué razón %s desea darse de baja?\\n(Esta información se guardará en las notas)"
msgstr "Why does %s want to unsubscribe?\\n(This information will be saved in the notes)"

msgid "¿Estás seguro de dar de baja a %s (%s)?\\n\\nEsta persona dejará de recibir el newsletter mensual."
msgstr "Are you sure you want to unsubscribe %s (%s)?\\n\\nThis person will stop receiving the monthly newsletter."

msgid "Dado de baja exitosamente"
msgstr "Successfully unsubscribed"

msgid "Total"
msgstr "Total"

msgid "Activos"
msgstr "Active"

msgid "Inactivos"
msgstr "Inactive"

msgid "Desuscritos"
msgstr "Unsubscribed"

msgid "Rebotados"
msgstr "Bounced"

msgid "Solo este sitio"
msgstr "This site only"

msgid "Todos los sitios de la red"
msgstr "All network sites"

msgid "Aplicar Filtro"
msgstr "Apply Filter"

msgid "Actualizar"
msgstr "Refresh"

msgid "Email"
msgstr "Email"

msgid "Estado"
msgstr "Status"

msgid "Sitio Web"
msgstr "Website"

msgid "Fecha"
msgstr "Date"

msgid "Origen"
msgstr "Source"

msgid "Acciones"
msgstr "Actions"

msgid "Cargando suscriptores..."
msgstr "Loading subscribers..."

msgid "Cambiar Estado del Suscriptor"
msgstr "Change Subscriber Status"

msgid "Nuevo Estado:"
msgstr "New Status:"

msgid "Notas (opcional):"
msgstr "Notes (optional):"

msgid "Estas notas se agregarán al historial del suscriptor"
msgstr "These notes will be added to the subscriber's history"

msgid "Actualizar Estado"
msgstr "Update Status"

msgid "Suscriptores"
msgstr "Subscribers"

msgid "Configuración"
msgstr "Settings"
